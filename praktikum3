<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Demo Fungsi PHP</title>
</head>
<body>
    <h2>Demo Fungsi dan Prosedur</h2>
    <?php
    // Fungsi tanpa parameter
    function salam() {
        echo "Halo, selamat datang di PHP!<br>";
    }

    // Fungsi dengan parameter dan return
    function jumlah($a, $b) {
        return $a + $b;
    }

    // Fungsi dengan parameter opsional
    function cetakTeks($teks, $tebal = true) {
        echo $tebal ? "<b>$teks</b><br>" : "$teks<br>";
    }

    // Pemanggilan fungsi
    salam();
    echo "Hasil penjumlahan 5 + 3 = " . jumlah(5, 3) . "<br>";
    cetakTeks("PHP itu keren!");
    cetakTeks("Belajar PHP menyenangkan", false);
    ?>
</body>
</html>
